# ───────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#  Two brands on one machine: keep one file per brand (`.env.aoysky`,
#  `.env.saodimallsu`) and pick it per command — `--env=.env.saodimallsu`, or
#  `ENV_FILE=.env.saodimallsu` for CI. `.gitignore` covers `.env.*`; only this
#  example file is committed.
#
#  Anything prefixed VITE_ is inlined into the browser bundle at build time —
#  that is fine for the anon/publishable key (it is designed to be public and
#  RLS is what actually protects the data). NEVER put a service_role key in a
#  VITE_ variable.
# ───────────────────────────────────────────────────────────────────────────

# ── 这个文件属于哪个品牌 ──────────────────────────────────────────────────
# BRAND_NAME 只用于脚本输出（"Saodimallsu → 批量 upsert"），不影响任何数据。
# BRAND_SLUG 是护栏：批处理脚本加 --expect-brand=<slug> 时，两者必须一致，
# 否则脚本直接拒绝执行。多品牌共用一个 checkout 时，这一行就是保险丝。
BRAND_NAME=Saodimallsu
BRAND_SLUG=sdm

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ── Script-only (no VITE_ prefix = never reaches the browser) ──────────────

# Used by: scripts/push-supabase.mjs, smoke-gate.mjs, smoke-realtime.mjs, shots.mjs
# Must be a confirmed user that is also listed in public.admin_users.

# Option A (recommended): sign in as the admin account you added to admin_users.
# Writes run as `authenticated`, which also proves the RLS policies work.
SUPABASE_ADMIN_EMAIL=ops@yourbrand.com
SUPABASE_ADMIN_PASSWORD=

# Option B: service role — bypasses RLS entirely.
# Only for a machine you trust; treat it like a database root password.
# SUPABASE_SERVICE_ROLE_KEY=
